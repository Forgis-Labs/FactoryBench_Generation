# Build output: staged submission archives and their PDFs.
# Rebuild with: make -C docs archives
dist/

# LaTeX aux files
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz

# Workshop PDFs are build output, not sources. `make -C docs archive-<venue>`
# regenerates them into dist/ along with the submission zip. (The full-paper
# PDFs under neurips_tex/ and iclr_tex/ predate this rule and stay tracked.)
workshop_tex/*.pdf

# Yanis's original workshop PDFs, kept beside the reconstructions as reference.
# Irreplaceable (the sources were never pushed and he has left), but 30 MB of
# blobs, so the provenance note is tracked and the PDFs are not. Back them up
# outside the repo, or drop this line to commit them.
reference-drafts/*.pdf
